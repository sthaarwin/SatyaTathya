# Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
# Comma-separated list of Gemini API keys for round-robin
# GEMINI_API_KEYS=key1,key2,key3

# Other Configurations
FRONTEND_URL=http://localhost:3000
FIRECRAWL_API_KEY=your_key_here

# NLI Model Configuration
USE_NLI_STANCE=true
NLI_MODEL_NAME=facebook/bart-large-mnli
NLI_CONFIDENCE_THRESHOLD=0.6

# Rate Limits (slowapi format: "[count]/[period]" e.g. "5/minute")
RATE_LIMIT_ANALYZE=5/minute
RATE_LIMIT_SEARCH=10/minute
RATE_LIMIT_STATS=20/minute
RATE_LIMIT_CACHE_CLEAR=2/minute
RATE_LIMIT_HEALTH=30/minute